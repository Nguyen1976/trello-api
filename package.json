{
  "name": "trello-api",
  "type": "commonjs",
  "version": "1.0.0",
  "description": "mern stack",
  "main": "src/server.js",
  "scripts": {
    "lint": "eslint src --ext js --report-unused-disable-directives --max-warnings 0",
    "clean": "rimraf build && mkdir build",
    "build-babel": "babel ./src -d ./build/src",
    "build": "npm run clean && npm run build-babel",
    "production": "npm run build && cross-env BUILD_MODE=production node ./build/src/server.js",
    "dev": "cross-env BUILD_MODE=dev nodemon --exec babel-node ./src/server.js",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "test:watch": "jest --watch",
    "test:integration": "jest --testPathPatterns=integration",
    "test:unit": "jest --testPathPatterns=unit",
    "test:fuzz": "jest --testPathPatterns=fuzz",
    "test:mutation": "stryker run",
    "lint:report": "eslint src --ext js -f stylish 2>&1 | tee ../docs/artifacts/eslint-api.txt || true"
  },
  "author": "",
  "license": "ISC",
  "private": true,
  "dependencies": {
    "@babel/runtime": "^7.22.10",
    "async-exit-hook": "^2.0.1",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.0.0",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "cross-env": "^7.0.3",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "http-status-codes": "^2.3.0",
    "joi": "^17.10.2",
    "jsonwebtoken": "^9.0.3",
    "lodash": "^4.17.21",
    "mongodb": "^6.14.1",
    "ms": "^2.1.3",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.10.0",
    "socket.io": "^4.8.1",
    "streamifier": "^0.1.1",
    "trello-api": "file:",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@babel/cli": "^7.22.10",
    "@babel/core": "^7.26.9",
    "@babel/eslint-parser": "^7.22.10",
    "@babel/node": "^7.26.0",
    "@babel/plugin-transform-runtime": "^7.22.10",
    "@babel/preset-env": "^7.26.9",
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/jest-runner": "^9.6.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.13.9",
    "babel-jest": "^30.4.1",
    "babel-plugin-module-resolver": "^5.0.2",
    "eslint": "^8.47.0",
    "eslint-config-prettier": "^10.0.2",
    "fast-check": "^4.8.0",
    "jest": "^30.4.2",
    "mongodb-memory-server": "^11.1.0",
    "mongoose": "^9.6.2",
    "nodemon": "^3.0.1",
    "rimraf": "^6.0.1",
    "supertest": "^7.2.2"
  }
}
